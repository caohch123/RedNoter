DATABASE_URL=postgresql://zhaixing:zhaixing@127.0.0.1:55432/zhaixing
REDIS_URL=redis://127.0.0.1:6380
APP_ORIGIN=http://localhost:3000
ACCOUNT_ME_URL=http://localhost:3000/api/auth/me
CREATION_PORT=3002
PUBLISH_READ_TOKEN=replace-with-a-long-local-token-before-use
MODEL_MODE=demo
MEDIA_MODE=local
# 逗号分隔的摘星用户 ID。主密钥应为 64 个十六进制字符。
# CREATION_MODEL_ADMIN_IDS=
# CREATION_MODEL_CONFIG_KEY=
# CREATION_MODEL_ORIGINS=https://provider.example
# CREATION_MEDIA_RESULT_ORIGINS=https://assets.example
# TOPICS_API_URL=
# ASSETS_API_URL=
# MODEL_MODE=pi
# PI_MODEL_PROVIDER=openai
# PI_MODEL_ID=your-model-id
# PI_MODEL_API_KEY=
# MEDIA_MODE=oss
# OSS_REGION=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=

# Pi 中栏运行器（npm run dev:pi）。API 与运行器共用同一个 token。
# PI_RUNNER_TOKEN=change-me
# PI_RUNNER_PORT=3013
# PI_RUNNER_HOST=127.0.0.1
# PI_RUNNER_URL=http://127.0.0.1:3013
# PI_ROOT=.creation-pi
# PI_AGENT_DIR=
# PI_TERMINAL_EXTENSIONS=samples/pi/terminal-desk.ts
# 中栏 Pi 可用模型白名单（逗号分隔 provider/id；留空显示全部可用模型）
# PI_ALLOWED_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-flash,google/gemini-3.8-flash,google/gemini-flash-lite-latest

# 小红书链接解析采集服务（npm run dev:collector，默认 5557 回环地址，纯匿名抓取）
# XHS_COLLECTOR_PORT=5557
# XHS_COLLECTOR_URL=http://127.0.0.1:5557
# XHS_COLLECTOR_TOKEN=
# XHS_COLLECTOR_PYTHON=

# 可选：联网搜索增强 API（不配也能用内置零 Key Bing/DuckDuckGo 搜索）
# BOCHA_API_KEY=
# TAVILY_API_KEY=
